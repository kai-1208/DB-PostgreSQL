# .env の設定例

# DB接続文字列 (通常はこのままコピーして .env として保存すればOK)
DATABASE_URL="postgresql://student:secret123@localhost:5432/playground?schema=public"

# docker\docker-compose.yaml をカスタマイズした場合のみ、接続文字列のパラメータを書き換えてください
#  [student]    → PostgreSQL のユーザ名
#  [secret123]  → PostgreSQL のパスワード
#  [playground] → PostgreSQL のデータベース名